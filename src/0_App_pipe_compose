const sum = (x)=>x+2
const multiply = (x) => x*5;
const sub = (x)=>x-1;

console.log(sub(multiply(sum(2))));


function pipe(...fns){
    return function(initialVal){
       return fns.reduce((acc, fn)=>{
            return fn(acc)
        },initialVal)
    }
}
function compose(...fns){
    return function(initialVal){
        return fns.reduceRight((acc, fn)=>{
            return fn(acc)
        },initialVal)
    }
}

console.log(pipe(sum, multiply, sub)(2))
console.log(compose(sub, multiply, sum)(2))
