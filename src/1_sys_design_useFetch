# ⚛️ SCALABLE `useFetch` HOOK (FULLY COMMENTED)

```jsx
import { useState, useEffect, useRef } from "react";

/*
  useFetch Hook
  -------------
  Features:
  - loading state
  - error handling
  - abort stale requests
  - in-memory cache
*/
export default function useFetch(url, options = {}) {

  // =============================
  // STATE
  // =============================

  // Holds API response
  const [data, setData] = useState(null);

  // Loading flag
  const [loading, setLoading] = useState(false);

  // Error state
  const [error, setError] = useState(null);


  // =============================
  // REFS
  // =============================

  // Cache map (URL -> response)
  const cacheRef = useRef(new Map());

  // Abort controller for cancelling old requests
  const abortControllerRef = useRef(null);


  // =============================
  // EFFECT
  // =============================

  useEffect(() => {

    // If no URL, skip fetch
    if (!url) return;

    // Check cache first
    if (cacheRef.current.has(url)) {

      // Use cached data instantly
      setData(cacheRef.current.get(url));
      return;
    }

    // Cancel previous request if running
    if (abortControllerRef.current) {
      abortControllerRef.current.abort();
    }

    // Create new controller
    abortControllerRef.current = new AbortController();

    // Start loading
    setLoading(true);

    // Reset error
    setError(null);

    // Perform fetch
    fetch(url, {
      ...options,
      signal: abortControllerRef.current.signal
    })
      .then(response => {

        // Handle HTTP errors
        if (!response.ok) {
          throw new Error(`Status ${response.status}`);
        }

        // Convert to JSON
        return response.json();
      })
      .then(result => {

        // Save in cache
        cacheRef.current.set(url, result);

        // Update state
        setData(result);
      })
      .catch(err => {

        // Ignore aborted fetch
        if (err.name !== "AbortError") {
          setError(err.message);
        }
      })
      .finally(() => {

        // Stop loader
        setLoading(false);
      });

    // Cleanup on unmount or URL change
    return () => {
      abortControllerRef.current?.abort();
    };

  }, [url]);


  // =============================
  // RETURN VALUES
  // =============================

  return { data, loading, error };
}
```

