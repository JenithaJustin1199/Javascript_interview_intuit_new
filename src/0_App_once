function once(fn){
    let called = false
    let result;
    return function(...args){
        if(!called){
            called = true;
            result = fn.apply(this, args)
        }
    }
    return result
}

function greet(name){
    console.log("Hello"+name)
    return "DONE"
}

let greetOnce = once(greet)

greetOnce("Jeni")
greetOnce("Ajaay")
