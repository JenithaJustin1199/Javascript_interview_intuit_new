class EventEmitter{
    constructor(){
        this.events = new Map()
    }
    subscribe(event, callback){
        if(!this.events.has(event)){
            this.events.set(event, new Set())
        }
        let listners = this.events.get(event)
        listners.add(callback)
        
        return ()=>{
            listners.delete(callback)
            if(listners.size === 0){
                this.events.delete(event)
            }
        }
        
    }
    emit(event, ...args){
        if(!this.events.get(event)) return
        let toBePublished = this.events.get(event)
        for(let cb of toBePublished){
            cb(...args)
        }
    }
}

let emitter = new EventEmitter()
